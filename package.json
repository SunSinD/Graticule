{
  "name": "graticule",
  "version": "2.0.5",
  "description": "A clean tool that turns oscilloscope screenshots into plots and data.",
  "author": "SunSinD",
  "license": "MIT",
  "files": [
    "dist-cli",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SunSinD/Graticule.git"
  },
  "homepage": "https://sunsind.github.io/Graticule/",
  "type": "module",
  "bin": {
    "graticule": "./dist-cli/cli/index.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.cli.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:prose": "node scripts/check-prose.mjs",
    "verify:parity": "node scripts/verify-parity.mjs",
    "build:portable": "node scripts/build-portable.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "cli": "tsx src/cli/index.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "0.28.2",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
